# ── Core ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/nickname?schema=public"
# Optional: direct (non-pooled) URL for migrations when DATABASE_URL is a pooler (Neon "-pooler", Supabase :6543)
DIRECT_DATABASE_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Nickname"
# Hosts that serve the main app (others are treated as custom domains)
APP_HOSTS="localhost:3000,localhost"

# ── Security ──────────────────────────────────────────
# openssl rand -hex 32
JWT_ACCESS_SECRET=""
# openssl rand -hex 32  (64 hex chars = 32 bytes, AES-256-GCM)
ENCRYPTION_KEY=""
# Secret for /api/cron/* endpoints (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# ── Seed ──────────────────────────────────────────────
# Production: use a real email + strong password (10+ chars) or the admin is NOT created.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="ChangeMe123!"
# Create the demo seller (demo@nickname.app / Demo12345 → /demo). Keep "false" in production!
SEED_DEMO="false"

# ── Email (optional — logs to console when empty) ────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Nickname <no-reply@example.com>"

# ── Uploads ──────────────────────────────────────────
# Driver is auto-detected: BLOB_READ_WRITE_TOKEN → Vercel Blob · S3_BUCKET → S3/R2 · otherwise local disk.
STORAGE_DRIVER=""
# Vercel serverless request bodies are limited to ~4.5 MB — keep MAX_UPLOAD_MB at 4 there.
MAX_UPLOAD_MB="4"
# local driver (dev / VPS)
UPLOAD_DIR="./storage/uploads"
# Vercel Blob (Vercel → Storage → Blob → connect; the token is added automatically)
BLOB_READ_WRITE_TOKEN=""
# S3-compatible: Cloudflare R2 example → S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto",
# S3_PUBLIC_URL = the bucket's public r2.dev URL or your custom CDN domain
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Platform billing gateways (subscription payments) ─
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_SANDBOX="true"

# Optional: URL the proxy uses to reach this app internally for custom-domain lookups
# (e.g. http://127.0.0.1:3000 behind a reverse proxy). Defaults to NEXT_PUBLIC_APP_URL.
INTERNAL_APP_URL=""
