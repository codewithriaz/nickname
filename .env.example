# ── Core ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/nickname?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Nickname"
# Hosts that serve the main app (others are treated as custom domains)
APP_HOSTS="localhost:3000,localhost"

# ── Security ──────────────────────────────────────────
# openssl rand -hex 32
JWT_ACCESS_SECRET=""
# openssl rand -hex 32  (64 hex chars = 32 bytes, AES-256-GCM)
ENCRYPTION_KEY=""
# Secret for /api/cron/* endpoints (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# ── Seed super admin ─────────────────────────────────
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# ── Email (optional — logs to console when empty) ────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Nickname <no-reply@example.com>"

# ── Uploads ──────────────────────────────────────────
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="5"

# ── Platform billing gateways (subscription payments) ─
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_SANDBOX="true"

# Optional: URL the proxy uses to reach this app internally for custom-domain lookups
# (e.g. http://127.0.0.1:3000 behind a reverse proxy). Defaults to NEXT_PUBLIC_APP_URL.
INTERNAL_APP_URL=""
